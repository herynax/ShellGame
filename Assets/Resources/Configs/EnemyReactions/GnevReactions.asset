    Groups:
    - Name: "\u0432\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u0435"
      Lines:
      - Text: "\u041D\u0443 \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439"
        TextColor: {r: 1, g: 1, b: 1, a: 1}
