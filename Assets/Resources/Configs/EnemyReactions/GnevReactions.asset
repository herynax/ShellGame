        #4"
      Lines:
      - Text: "\u0421\u043D\u0438\u043C\u0438 \u044D\u0442\u043E."
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
          Guid:
            Data1: 1216949052
            Data2: 1122177664
            Data3: -1760383847
            Data4: -615476754
