        MinDisplayDuration: 0.6
        WaitForClick: 1
      - Text: "\u041F\u043E\u0437\u043E\u0440\u043D\u043E \u043F\u0440\u043E\u0438\u0433\u0440\u044B\u0432\u0430\u0442\u044C
          \u0442\u0435\u0431\u0435."
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
          Guid:
            Data1: 1216949052
            Data2: 1122177664
            Data3: -1760383847
            Data4: -615476754
          Path: event:/SFX/Enemie/e_Voice
        MinDisplayDuration: 0.6
        WaitForClick: 1
  - Context: 9
    Priority: 300
    AlwaysShow: 1
    CooldownSeconds: 0
    MinTurn: 0
    MaxTurn: 0
    Conditions: []
    Groups:
    - Name: "\u0444\u0438\u043D\u0430\u043B: \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u0435"
      Lines:
      - Text: "\u0412\u043E\u0442 \u0438 \u0432\u0441\u0451. \u0410 \u044F \u0434\u0443\u043C\u0430\u043B,
          \u0441 \u0442\u043E\u0431\u043E\u0439 \u0434\u043E\u043B\u044C\u0448\u0435
          \u0432\u043E\u0437\u0438\u0442\u044C\u0441\u044F \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F"
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
          Guid:
            Data1: 1216949052
            Data2: 1122177664
            Data3: -1760383847
            Data4: -615476754
          Path: event:/SFX/Enemie/e_Voice
        MinDisplayDuration: 0.6
        WaitForClick: 1
      - Text: "\u041D\u0443 \u043D\u0430\u043A\u043E\u043D\u0435\u0446-\u0442\u043E.
          \u0423\u0436\u0435 \u043D\u0430\u0447\u0430\u043B \u043C\u043D\u0435 \u043D\u0430\u0434\u043E\u0435\u0434\u0430\u0442\u044C"
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
          Guid:
            Data1: 1216949052
            Data2: 1122177664
            Data3: -1760383847
            Data4: -615476754
          Path: event:/SFX/Enemie/e_Voice
        MinDisplayDuration: 0.6
        WaitForClick: 1
      - Text: "\u0412\u043E\u0442 \u0442\u0435\u043F\u0435\u0440\u044C \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0438.
          \u0422\u0430\u043A \u0433\u043E\u0440\u0430\u0437\u0434\u043E \u043B\u0443\u0447\u0448\u0435"
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
          Guid:
            Data1: 1216949052
            Data2: 1122177664
            Data3: -1760383847
            Data4: -615476754
          Path: event:/SFX/Enemie/e_Voice
        MinDisplayDuration: 0.6
        WaitForClick: 1
      - Text: "\u041D\u0443 \u0447\u0442\u043E, \u0434\u043E\u0438\u0433\u0440\u0430\u043B\u0441\u044F?
          \u042F \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0430\u0442\u044C
          \u043D\u0435 \u0441\u043E\u0431\u0438\u0440\u0430\u043B\u0441\u044F"
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
          Guid:
            Data1: 1216949052
            Data2: 1122177664
            Data3: -1760383847
            Data4: -615476754
          Path: event:/SFX/Enemie/e_Voice
        MinDisplayDuration: 0.6
        WaitForClick: 1
      - Text: "\u041D\u0438\u0447\u0435\u0433\u043E \u043B\u0438\u0447\u043D\u043E\u0433\u043E.
          \u041F\u0440\u043E\u0441\u0442\u043E \u0442\u044B \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0441\u044F
          \u0440\u0430\u043D\u044C\u0448\u0435"
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
          Guid:
            Data1: 1216949052
            Data2: 1122177664
            Data3: -1760383847
            Data4: -615476754
          Path: event:/SFX/Enemie/e_Voice
        MinDisplayDuration: 0.6
        WaitForClick: 1
