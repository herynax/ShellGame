        MinDisplayDuration: 0.6
        WaitForClick: 1
    - Name: "\u043D\u043E\u0436 #2"
      Lines:
      - Text: "\u041D\u0443 \u043A\u043E\u043D\u0435\u0447\u043D\u043E. \u041A\u043E\u0433\u0434\u0430
          \u0438\u0433\u0440\u0430\u0442\u044C \u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0441\u044F
          \u2014 \u0440\u0435\u0436\u044C."
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
          Guid:
            Data1: 1216949052
            Data2: 1122177664
            Data3: -1760383847
            Data4: -615476754
          Path: event:/SFX/Enemie/e_Voice
        MinDisplayDuration: 0.6
        WaitForClick: 1
    - Name: "\u043D\u043E\u0436 #3"
      Lines:
      - Text: "\u041A\u043E\u0433\u0434\u0430 \u0434\u0443\u043C\u0430\u0442\u044C
          \u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0441\u044F
          \u2013 \u0440\u0435\u0436\u044C. \u042F \u0442\u0430\u043A \u043D\u0430
          \u043C\u0430\u043B\u043E\u043B\u0435\u0442\u043A\u0443 \u043F\u043E\u043F\u0430\u043B"
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
          Guid:
            Data1: 1216949052
            Data2: 1122177664
            Data3: -1760383847
            Data4: -615476754
          Path: event:/SFX/Enemie/e_Voice
        MinDisplayDuration: 0.6
        WaitForClick: 1
    - Name: "\u043D\u043E\u0436 #4"
      Lines:
      - Text: "\u0423\u0411\u0415\u0420\u0418 \u041D\u041E\u0416."
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
          Guid:
            Data1: 1216949052
            Data2: 1122177664
            Data3: -1760383847
            Data4: -615476754
          Path: event:/SFX/Enemie/e_Voice
        MinDisplayDuration: 0.6
        WaitForClick: 1
    - Name: "\u043D\u043E\u0436 #5"
      Lines:
      - Text: "\u042F \u0422\u0415\u0411\u0415 \u0415\u0413\u041E \u0412 \u0413\u041E\u0420\u041B\u041E
          \u0417\u0410\u041F\u0418\u0425\u041D\u0423."
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
