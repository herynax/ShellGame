        #1"
      Lines:
      - Text: "\u0421\u0432\u044F\u0437\u0430\u0442\u044C \u043C\u0435\u043D\u044F
          \u043F\u0440\u043E\u0449\u0435, \u0447\u0435\u043C \u0432\u044B\u0438\u0433\u0440\u0430\u0442\u044C,
          \u0434\u0430?"
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
          Guid:
            Data1: 1216949052
            Data2: 1122177664
            Data3: -1760383847
            Data4: -615476754
          Path: event:/SFX/Enemie/e_Voice
        MinDisplayDuration: 0.6
        WaitForClick: 1
    - Name: " \u043D\u0430\u0440\u0443\u0447\u043D\u0438\u043A\u0438 (\u0438\u0433\u0440\u043E\u043A)
        #2"
      Lines:
      - Text: "\u041A\u043E\u043D\u0435\u0447\u043D\u043E. \u041F\u0440\u043E\u0438\u0433\u0440\u044B\u0432\u0430\u0435\u0448\u044C
          \u2014 \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0435 \u0434\u0430\u0439
          \u0434\u0440\u0443\u0433\u043E\u043C\u0443 \u0438\u0433\u0440\u0430\u0442\u044C."
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
          Guid:
            Data1: 1216949052
            Data2: 1122177664
            Data3: -1760383847
            Data4: -615476754
          Path: event:/SFX/Enemie/e_Voice
        MinDisplayDuration: 0.6
        WaitForClick: 1
    - Name: " \u043D\u0430\u0440\u0443\u0447\u043D\u0438\u043A\u0438 (\u0438\u0433\u0440\u043E\u043A)
        #3"
      Lines:
      - Text: "\u0421\u043D\u0438\u043C\u0438."
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
          Guid:
            Data1: 1216949052
            Data2: 1122177664
            Data3: -1760383847
            Data4: -615476754
