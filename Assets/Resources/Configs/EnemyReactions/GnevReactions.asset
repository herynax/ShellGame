    - Type: 10
      Item: {fileID: 0}
      User: 1
      Amount: 0
      Seconds: 0
      Fraction: 0
    Groups:
    - Name: MDMA #1
      Lines:
      - Text: "\u0411\u0435\u0437 \u0445\u0438\u043C\u0438\u0438 \u0443\u0436\u0435
          \u0441\u043E\u0432\u0441\u0435\u043C \u0441\u0442\u0440\u0430\u0448\u043D\u043E?"
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
          Guid:
            Data1: 1216949052
            Data2: 1122177664
            Data3: -1760383847
            Data4: -615476754
          Path: event:/SFX/Enemie/e_Voice
        MinDisplayDuration: 0.6
        WaitForClick: 1
    - Name: MDMA #2
      Lines:
      - Text: "\u041D\u0443 \u0434\u0430\u0432\u0430\u0439, \u0437\u0430\u043A\u0438\u043D\u044C\u0441\u044F.
          \u0412\u0434\u0440\u0443\u0433 \u0445\u043E\u0442\u044C \u0442\u0430\u043A
          \u043D\u0430\u0447\u043D\u0451\u0448\u044C \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E
          \u0441\u043E\u043E\u0431\u0440\u0430\u0436\u0430\u0442\u044C."
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
          Guid:
            Data1: 1216949052
            Data2: 1122177664
            Data3: -1760383847
            Data4: -615476754
          Path: event:/SFX/Enemie/e_Voice
        MinDisplayDuration: 0.6
        WaitForClick: 1
    - Name: MDMA #3
      Lines:
      - Text: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E. \u0422\u0435\u043F\u0435\u0440\u044C
          \u0442\u044B \u0435\u0449\u0451 \u0438 \u043E\u0431\u0434\u043E\u043B\u0431\u0430\u043D\u043D\u044B\u0439
          \u0434\u043E\u043B\u0431\u043E\u0451\u0431."
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
          Guid:
            Data1: 1216949052
            Data2: 1122177664
            Data3: -1760383847
            Data4: -615476754
          Path: event:/SFX/Enemie/e_Voice
        MinDisplayDuration: 0.6
        WaitForClick: 1
    - Name: MDMA #4
      Lines:
      - Text: "\u041D\u0443 \u043A\u043E\u043D\u0435\u0447\u043D\u043E. \u0421\u0430\u043C\u043E\u043C\u0443
          \u0443\u0436\u0435 \u043D\u0438\u043A\u0430\u043A."
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
          Guid:
            Data1: 1216949052
            Data2: 1122177664
            Data3: -1760383847
            Data4: -615476754
          Path: event:/SFX/Enemie/e_Voice
        MinDisplayDuration: 0.6
        WaitForClick: 1
  - Context: 6
    Priority: 150
    AlwaysShow: 0
