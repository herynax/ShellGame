    - Name: "\u043F\u0440\u043E\u043C\u0430\u0445 #1"
      Lines:
      - Text: "\u0423\u0434\u0438\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E.
          \u0422\u0440\u0438 \u0435\u0431\u0430\u043D\u044B\u0445 \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u0430
          \u2014 \u0438 \u0442\u044B \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E
          \u043D\u0430\u0445\u043E\u0434\u0438\u0448\u044C \u043D\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439."
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
          Guid:
            Data1: 1216949052
            Data2: 1122177664
            Data3: -1760383847
            Data4: -615476754
          Path: event:/SFX/Enemie/e_Voice
        MinDisplayDuration: 0.6
        WaitForClick: 1
    - Name: "\u043F\u0440\u043E\u043C\u0430\u0445 #2"
      Lines:
      - Text: "\u0422\u044B \u0432\u0441\u0435\u0433\u0434\u0430 \u0441\u043D\u0430\u0447\u0430\u043B\u0430
          \u043D\u0430\u0436\u0438\u043C\u0430\u0435\u0448\u044C, \u0430 \u043F\u043E\u0442\u043E\u043C
          \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0448\u044C \u043F\u043E\u043D\u0438\u043C\u0430\u0442\u044C?"
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
          Guid:
            Data1: 1216949052
            Data2: 1122177664
            Data3: -1760383847
            Data4: -615476754
          Path: event:/SFX/Enemie/e_Voice
        MinDisplayDuration: 0.6
        WaitForClick: 1
    - Name: "\u043F\u0440\u043E\u043C\u0430\u0445 #3"
      Lines:
      - Text: "\u041E\u043F\u044F\u0442\u044C. \u0422\u044B \u0432\u043E\u043E\u0431\u0449\u0435
          \u0441\u043F\u043E\u0441\u043E\u0431\u0435\u043D \u0447\u0435\u043C\u0443-\u043D\u0438\u0431\u0443\u0434\u044C
          \u043D\u0430\u0443\u0447\u0438\u0442\u044C\u0441\u044F?"
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
          Guid:
            Data1: 1216949052
            Data2: 1122177664
            Data3: -1760383847
            Data4: -615476754
          Path: event:/SFX/Enemie/e_Voice
        MinDisplayDuration: 0.6
        WaitForClick: 1
    - Name: "\u043F\u0440\u043E\u043C\u0430\u0445 #4"
      Lines:
      - Text: "\u0422\u044B \u043F\u0440\u0430\u0432\u0434\u0430 \u0432\u044B\u0431\u0440\u0430\u043B
          \u0438\u043C\u0435\u043D\u043D\u043E \u044D\u0442\u043E\u0442?"
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
          Guid:
            Data1: 1216949052
            Data2: 1122177664
            Data3: -1760383847
            Data4: -615476754
          Path: event:/SFX/Enemie/e_Voice
        MinDisplayDuration: 0.6
        WaitForClick: 1
    - Name: "\u043F\u0440\u043E\u043C\u0430\u0445 #5"
      Lines:
      - Text: "\u0422\u044B \u0432\u043E\u043E\u0431\u0449\u0435 \u0434\u0443\u043C\u0430\u0435\u0448\u044C
          \u043A\u043E\u0433\u0434\u0430 \u0432\u044B\u0431\u0438\u0440\u0430\u0435\u0448\u044C?"
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
          Guid:
            Data1: 1216949052
            Data2: 1122177664
            Data3: -1760383847
            Data4: -615476754
          Path: event:/SFX/Enemie/e_Voice
        MinDisplayDuration: 0.6
