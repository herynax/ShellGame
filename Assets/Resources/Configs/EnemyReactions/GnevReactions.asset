      Seconds: 0
      Fraction: 0
    Groups:
    - Name: "\u043C\u043E\u043D\u043E\u043A\u043B\u044C #1"
      Lines:
      - Text: "\u041F\u043E\u0434\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0439.
          \u0421\u0432\u043E\u0435\u0439 \u0433\u043E\u043B\u043E\u0432\u043E\u0439,
          \u044F \u0432\u0438\u0436\u0443, \u0442\u044F\u0436\u0435\u043B\u043E\u0432\u0430\u0442\u043E."
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
          Guid:
            Data1: 1216949052
            Data2: 1122177664
            Data3: -1760383847
            Data4: -615476754
          Path: event:/SFX/Enemie/e_Voice
        MinDisplayDuration: 0.6
        WaitForClick: 1
    - Name: "\u043C\u043E\u043D\u043E\u043A\u043B\u044C #2"
      Lines:
      - Text: "\u0425\u043E\u0440\u043E\u0448\u0430\u044F \u0432\u0435\u0449\u044C.
          \u041E\u0441\u043E\u0431\u0435\u043D\u043D\u043E \u043A\u043E\u0433\u0434\u0430
          \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
          \u0443\u043C\u0430 \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442."
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
          Guid:
            Data1: 1216949052
            Data2: 1122177664
            Data3: -1760383847
            Data4: -615476754
          Path: event:/SFX/Enemie/e_Voice
        MinDisplayDuration: 0.6
        WaitForClick: 1
    - Name: "\u043C\u043E\u043D\u043E\u043A\u043B\u044C #3"
      Lines:
      - Text: "\u0422\u0435\u0431\u0435 \u0435\u0449\u0451 \u043F\u0430\u043B\u044C\u0446\u0435\u043C
          \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C, \u043A\u0443\u0434\u0430
          \u043D\u0430\u0436\u0430\u0442\u044C?"
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
          Guid:
            Data1: 1216949052
            Data2: 1122177664
            Data3: -1760383847
            Data4: -615476754
          Path: event:/SFX/Enemie/e_Voice
        MinDisplayDuration: 0.6
        WaitForClick: 1
