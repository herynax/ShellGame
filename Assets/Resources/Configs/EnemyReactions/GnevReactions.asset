    - Name: "\u043A\u0440\u0435\u0441\u0442 #1"
      Lines:
      - Text: "\u041E\u043F\u044F\u0442\u044C \u043A\u0442\u043E-\u0442\u043E \u0434\u043E\u043B\u0436\u0435\u043D
          \u043F\u0440\u0438\u043D\u044F\u0442\u044C \u0443\u0434\u0430\u0440 \u0432\u043C\u0435\u0441\u0442\u043E
          \u0442\u0435\u0431\u044F?"
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
          Guid:
            Data1: 1216949052
            Data2: 1122177664
            Data3: -1760383847
            Data4: -615476754
          Path: event:/SFX/Enemie/e_Voice
        MinDisplayDuration: 0.6
        WaitForClick: 1
    - Name: "\u043A\u0440\u0435\u0441\u0442 #2"
      Lines:
      - Text: "\u041A\u0430\u043A \u0442\u0430\u043C \u0431\u044B\u043B\u043E, \"\u0432\u043E\u0437\u044C\u043C\u0438
          \u0441\u0432\u043E\u0439 \u043A\u0440\u0435\u0441\u0442 \u0438 \u0441\u043B\u0435\u0434\u0443\u0439
          \u0437\u0430 \u043C\u043D\u043E\u0439\"? \u041F\u043B\u0435\u0432\u0430\u0442\u044C,
          \u0432\u0441\u0435 \u0440\u043E\u0432\u043D\u043E \u043D\u0438\u043A\u043E\u0433\u0434\u0430
          \u043D\u0435 \u0447\u0438\u0442\u0430\u043B \u044D\u0442\u043E\u0442 \u0431\u0440\u0435\u0434"
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
          Guid:
            Data1: 1216949052
            Data2: 1122177664
            Data3: -1760383847
            Data4: -615476754
          Path: event:/SFX/Enemie/e_Voice
        MinDisplayDuration: 0.6
        WaitForClick: 1
    - Name: "\u043A\u0440\u0435\u0441\u0442 #3"
      Lines:
      - Text: "\u0414\u0430, \u0434\u0430\u0432\u0430\u0439. \u0421\u043F\u0440\u044F\u0447\u044C\u0441\u044F
          \u0437\u0430 \u0447\u0435\u043C-\u043D\u0438\u0431\u0443\u0434\u044C."
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
          Guid:
            Data1: 1216949052
            Data2: 1122177664
            Data3: -1760383847
            Data4: -615476754
          Path: event:/SFX/Enemie/e_Voice
        MinDisplayDuration: 0.6
        WaitForClick: 1
