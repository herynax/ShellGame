            Data4: -615476754
          Path: event:/SFX/Enemie/e_Voice
        MinDisplayDuration: 0.6
        WaitForClick: 1
    - Name: "\u043C\u043E\u043B\u043E\u0442\u043E\u043A #2"
      Lines:
      - Text: "\u041D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E. \u041C\u043E\u0437\u0433\u043E\u0432
          \u043D\u0435 \u0445\u0432\u0430\u0442\u0438\u043B\u043E, \u0437\u0430\u0442\u043E
          \u043C\u043E\u043B\u043E\u0442\u043E\u043A \u043D\u0430\u0448\u0451\u043B\u0441\u044F."
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
          Guid:
            Data1: 1216949052
            Data2: 1122177664
            Data3: -1760383847
            Data4: -615476754
          Path: event:/SFX/Enemie/e_Voice
        MinDisplayDuration: 0.6
        WaitForClick: 1
    - Name: "\u043C\u043E\u043B\u043E\u0442\u043E\u043A #3"
      Lines:
      - Text: "\u0412\u043E\u0442 \u044D\u0442\u043E \u044F \u043F\u043E\u043D\u0438\u043C\u0430\u044E.
          \u041D\u0430\u043A\u043E\u043D\u0435\u0446 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442
          \u043F\u043E\u0434 \u0442\u0432\u043E\u0439 \u0443\u0440\u043E\u0432\u0435\u043D\u044C."
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
          Guid:
            Data1: 1216949052
            Data2: 1122177664
            Data3: -1760383847
            Data4: -615476754
          Path: event:/SFX/Enemie/e_Voice
        MinDisplayDuration: 0.6
        WaitForClick: 1
    - Name: "\u043C\u043E\u043B\u043E\u0442\u043E\u043A #4"
      Lines:
      - Text: "\u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E. \u041A\u043E\u0433\u0434\u0430
          \u043C\u0438\u0440 \u043D\u0435 \u043F\u043E\u0434\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442\u0441\u044F,
          \u0442\u044B \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0448\u044C
          \u0435\u0433\u043E \u043B\u043E\u043C\u0430\u0442\u044C?"
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
          Guid:
            Data1: 1216949052
            Data2: 1122177664
