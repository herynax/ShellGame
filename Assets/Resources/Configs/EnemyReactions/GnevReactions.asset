          Path: event:/SFX/Enemie/e_Voice
        MinDisplayDuration: 0.6
        WaitForClick: 1
      - Text: "\u0417\u043D\u0430\u043A\u043E\u043C\u0438\u0442\u044C\u0441\u044F
          \u043D\u0435 \u0445\u043E\u0447\u0443, \u0431\u043E\u043B\u0442\u0430\u0442\u044C
          \u0442\u043E\u0436\u0435"
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
          Guid:
            Data1: 1216949052
            Data2: 1122177664
            Data3: -1760383847
            Data4: -615476754
          Path: event:/SFX/Enemie/e_Voice
        MinDisplayDuration: 0.6
        WaitForClick: 1
      - Text: "\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0445\u043E\u0442\u044F
          \u0431\u044B \u0442\u044F\u043D\u0443\u0442\u044C \u0432\u0440\u0435\u043C\u044F
          \u043D\u0435 \u0431\u0443\u0434\u0435\u0448\u044C, \u0430 \u0442\u043E
          \u0442\u0435\u0440\u043F\u0435\u043D\u0438\u044F \u0443 \u043C\u0435\u043D\u044F
          \u043C\u0430\u043B\u043E"
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
          Guid:
            Data1: 1216949052
            Data2: 1122177664
            Data3: -1760383847
            Data4: -615476754
          Path: event:/SFX/Enemie/e_Voice
        MinDisplayDuration: 0.6
        WaitForClick: 1
      - Text: "\u0414\u0430\u0432\u0430\u0439 \u043D\u0430\u0447\u0438\u043D\u0430\u0442\u044C,
          \u043D\u0435 \u0445\u043E\u0447\u0443 \u0441 \u0442\u043E\u0431\u043E\u0439
          \u0434\u043E\u043B\u0433\u043E \u0432\u043E\u0437\u0438\u0442\u044C\u0441\u044F"
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
          Guid:
            Data1: 1216949052
            Data2: 1122177664
            Data3: -1760383847
            Data4: -615476754
          Path: event:/SFX/Enemie/e_Voice
        MinDisplayDuration: 0.6
        WaitForClick: 1
  - Context: 8
    Priority: 200
    AlwaysShow: 1
    CooldownSeconds: 0
    MinTurn: 1
    MaxTurn: 1
    Conditions: []
    Groups:
    - Name: "\u0440\u0430\u0437\u043E\u0447\u0430\u0440\u043E\u0432\u0430\u043D\u0438\u0435"
      Lines:
      - Text: "\u0421\u043A\u043E\u0442\u0438\u043D\u0430\u2026"
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
          Guid:
            Data1: 1216949052
            Data2: 1122177664
            Data3: -1760383847
            Data4: -615476754
          Path: event:/SFX/Enemie/e_Voice
        MinDisplayDuration: 0.6
        WaitForClick: 1
      - Text: "\u0412\u0441\u0442\u0440\u0435\u0442\u0438\u043C\u0441\u044F, \u043A\u043E\u0433\u0434\u0430
          \u0442\u0435\u0431\u044F \u043E\u043F\u044F\u0442\u044C \u043F\u043E \u043A\u0440\u0443\u0433\u0443
          \u043F\u0443\u0441\u0442\u044F\u0442."
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
          Guid:
            Data1: 1216949052
            Data2: 1122177664
            Data3: -1760383847
            Data4: -615476754
          Path: event:/SFX/Enemie/e_Voice
        MinDisplayDuration: 0.6
        WaitForClick: 1
    - Name: "\u0437\u043B\u043E\u0441\u0442\u044C"
      Lines:
      - Text: "\u0414\u0430 \u0447\u0442\u043E\u0431 \u0442\u0435\u0431\u044F\u2026"
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
          Guid:
            Data1: 1216949052
            Data2: 1122177664
            Data3: -1760383847
            Data4: -615476754
          Path: event:/SFX/Enemie/e_Voice
        MinDisplayDuration: 0.6
        WaitForClick: 1
      - Text: "\u042F \u044D\u0442\u0443 \u0434\u0440\u044F\u043D\u044C \u0434\u043E
          \u0441\u0438\u0445 \u043F\u043E\u0440 \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E"
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
          Guid:
            Data1: 1216949052
            Data2: 1122177664
            Data3: -1760383847
            Data4: -615476754
          Path: event:/SFX/Enemie/e_Voice
        MinDisplayDuration: 0.6
        WaitForClick: 1
      - Text: "\u0418 \u043F\u043E\u0441\u043B\u0435 \u044D\u0442\u043E\u0433\u043E
          \u0442\u044B \u0435\u0449\u0451 \u0432\u044B\u0438\u0433\u0440\u044B\u0432\u0430\u043B"
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
          Guid:
            Data1: 1216949052
            Data2: 1122177664
            Data3: -1760383847
            Data4: -615476754
          Path: event:/SFX/Enemie/e_Voice
        MinDisplayDuration: 0.6
        WaitForClick: 1
      - Text: "\u0412\u043E\u0442 \u044D\u0442\u043E \u044F \u0442\u0435\u0431\u0435
          \u043D\u0435 \u0437\u0430\u0431\u0443\u0434\u0443."
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
          Guid:
            Data1: 1216949052
            Data2: 1122177664
            Data3: -1760383847
            Data4: -615476754
          Path: event:/SFX/Enemie/e_Voice
        MinDisplayDuration: 0.6
