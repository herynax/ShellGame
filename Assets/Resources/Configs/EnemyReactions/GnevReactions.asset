      - Text: "\u041C\u043D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F,
          \u043A\u0430\u043A \u0442\u044B \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0430\u0435\u0448\u044C
          \u043C\u044B\u0441\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
          \u043F\u0440\u043E\u0446\u0435\u0441\u0441."
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
          Guid:
            Data1: 1216949052
            Data2: 1122177664
            Data3: -1760383847
            Data4: -615476754
          Path: event:/SFX/Enemie/e_Voice
        MinDisplayDuration: 0.6
        WaitForClick: 1
  - Context: 6
    Priority: 150
    AlwaysShow: 0
    CooldownSeconds: 6
    MinTurn: 0
    MaxTurn: 0
    Conditions:
    - Type: 9
      Item: {fileID: 11400000, guid: 47a37eca24d58854097db80807067fed, type: 2}
