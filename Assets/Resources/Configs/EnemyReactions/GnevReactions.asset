            Data3: -1760383847
            Data4: -615476754
          Path: event:/SFX/Enemie/e_Voice
        MinDisplayDuration: 0.6
        WaitForClick: 1
    - Name: "\u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435 #2"
      Lines:
      - Text: "\u041C\u043E\u043B\u043E\u0434\u0435\u0446. \u041C\u0435\u0434\u0430\u043B\u044C
          \u0442\u0435\u0431\u0435 \u0434\u0430\u0442\u044C?"
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
          Guid:
            Data1: 1216949052
            Data2: 1122177664
            Data3: -1760383847
            Data4: -615476754
          Path: event:/SFX/Enemie/e_Voice
        MinDisplayDuration: 0.6
        WaitForClick: 1
    - Name: "\u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435 #3"
      Lines:
      - Text: "\u041E, \u043F\u043E\u043F\u0430\u043B. \u0421\u0435\u0439\u0447\u0430\u0441
          \u0435\u0449\u0451 \u0433\u043E\u0440\u0434\u0438\u0442\u044C\u0441\u044F
          \u0441\u043E\u0431\u043E\u0439 \u043D\u0430\u0447\u043D\u0451\u0448\u044C."
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
          Guid:
            Data1: 1216949052
            Data2: 1122177664
            Data3: -1760383847
            Data4: -615476754
          Path: event:/SFX/Enemie/e_Voice
        MinDisplayDuration: 0.6
        WaitForClick: 1
    - Name: "\u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435 #4"
      Lines:
      - Text: "\u0422\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439
          \u0440\u0435\u0448\u0438\u0442\u044C, \u0447\u0442\u043E \u044D\u0442\u043E
          \u0442\u044B \u0445\u043E\u0440\u043E\u0448\u043E \u0441\u044B\u0433\u0440\u0430\u043B."
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
          Guid:
            Data1: 1216949052
            Data2: 1122177664
            Data3: -1760383847
            Data4: -615476754
          Path: event:/SFX/Enemie/e_Voice
        MinDisplayDuration: 0.6
        WaitForClick: 1
    - Name: "\u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435 #6"
      Lines:
      - Text: "\u0422\u044B \u043C\u0435\u043D\u044F \u043D\u0435 \u043F\u043E\u0431\u0435\u0434\u0438\u043B.
          \u0421\u043B\u044B\u0448\u0438\u0448\u044C? \u041D\u0415 \u041F\u041E\u0411\u0415\u0414\u0418\u041B."
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
          Guid:
            Data1: 1216949052
            Data2: 1122177664
            Data3: -1760383847
            Data4: -615476754
          Path: event:/SFX/Enemie/e_Voice
        MinDisplayDuration: 0.6
        WaitForClick: 1
    - Name: "\u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0435 #8"
