      Lines:
      - Text: "\u041D\u0443 \u043A\u043E\u043D\u0435\u0447\u043D\u043E. \u041D\u0435
          \u043F\u043E\u043D\u044F\u043B \u2014 \u0440\u0430\u0437\u0431\u0435\u0439."
        TextColor: {r: 1, g: 1, b: 1, a: 1}
