    - Name: "\u043D\u043E\u0436 #1"
      Lines:
      - Text: "\u041D\u0435 \u0442\u0440\u043E\u0433\u0430\u0439 \u0431\u043E\u043B\u044C\u0448\u0435
          \u043E\u0441\u0442\u0440\u043E\u0435."
        TextColor: {r: 1, g: 1, b: 1, a: 1}
        VoiceEvent:
